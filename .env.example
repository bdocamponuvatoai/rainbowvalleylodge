# Public URL of the site, without a trailing slash. Used for canonical URLs,
# Open Graph images, robots.txt and the sitemap. When unset, falls back to
# https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel, then http://localhost:3000.
SITE_URL=https://www.example.com

# Let search engines index the site. Keep "false" until the owner approves the
# launch; the build fails if this is "true" while SITE_URL is still localhost.
SITE_INDEXABLE=false
